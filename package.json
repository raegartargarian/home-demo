    "web3": "^4.16.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@eslint/js": "^9.11.1",
    "@types/leaflet": "^1.9.14",
    "@types/node": "^22.7.7",
