{
  "name": "home-record-demo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:test": "vite --mode test",
    "dev:prod": "vite --mode prod",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "format": "prettier  src \"*/**.{js.jsx,ts,tsx,css.md}\" --check --ignore-path .gitignore --write",
    "lint": "eslint src",
    "lint:prettier": "prettier \"**/*.(md|json|yml)\" --ignore-path .gitignore --check",
    "test": "vitest run",
    "examples": "esbuild scripts/generateExampleFiles.ts --bundle --platform=node --format=esm --alias:@=./src --outfile=node_modules/.cache/generateExampleFiles.mjs --log-level=warning && node node_modules/.cache/generateExampleFiles.mjs && npm run examples:media",
    "examples:media": "node scripts/generateExampleMedia.mjs"
  },
  "overrides": {
    "ws": "^8.21.0",
    "js-cookie": "^3.0.8",
    "uuid": "^11.1.1",
    "vitest": {
      "vite": "8.0.16"
    }
  },
  "dependencies": {
    "@filedgr/web-core": "^0.7.6",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-icons": "^1.3.0",
