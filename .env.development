# Local development. Mirrors filedgr-web-app: local dev runs against the *dev*
# Web3Auth project and the dev backend. Pointing local dev at the production
# Web3Auth project is what caused "could not validate redirect, please whitelist
# your domain: http://localhost:5173" — that project has no localhost origin
# whitelisted, and it never will.
#
# Deployed environments use .env.test / .env.prod.
VITE_AUTH_CLIENT_ID="BNSyDdH_nAxDiITmWzlmGbdZXDqXDPPKLT6rGhIywzAqNmP6QgLllTc3pemXYwFZa4DCKQEwckIhK3DJK2GwQVM"
VITE_API_URL="https://webapp-api.dev.filedgr.network"
VITE_EXPLORER_URL="https://explorer.dev.filedgr.network"
VITE_ENV="development"

# Backend template_id per scenario (see src/shared/constants/scenarios.ts).
# `vaults/saga.ts` reads exactly these four keys and fetches across them; with
# all four empty the vault list is empty, however the login went. Fill each with
# the seeded template_id for that scenario on this environment.
# Only New Construction is wired up so far; the other three scenarios show an
# empty vault list until their templates are seeded.
VITE_TEMPLATE_NEW_CONSTRUCTION="14f01691-6551-457f-9ac4-65a1a1db0c68"
VITE_TEMPLATE_WHOLE_HOME_RENO=""
VITE_TEMPLATE_SINGLE_ROOM=""
VITE_TEMPLATE_ESTABLISHED_HOME=""
