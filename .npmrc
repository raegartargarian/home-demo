# @filedgr/* packages are published to GitHub Packages (private, org-only).
# Auth via NODE_AUTH_TOKEN — set in CI to a token with read:packages
# (e.g. PACKAGES_GHCR_TOKEN); locally, `export NODE_AUTH_TOKEN=$(gh auth token)`
# after `gh auth refresh -s read:packages`.
@filedgr:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
